DISCORD_BOT_TOKEN=your_bot_token_here
TARGET_USER_ID=123456789
# all = record everyone in the channel, target = record only TARGET_USER_ID
RECORD_MODE=all
# Timezone for session folder names (container default is UTC)
TZ=Europe/Sofia
# How often (seconds) to re-check the target's location; lower = faster reaction
POLL_SECONDS=0.2
# silence longer than this ends a recording; shorter pauses stay in it
SILENCE_SPLIT_SECONDS=5
# seconds of silence added before and after each saved recording
PAD_SECONDS=0.2
# discard recordings with less than this much actual speech
MIN_RECORDING_SECONDS=0.2
